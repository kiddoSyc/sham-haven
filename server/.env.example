NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# For phone testing over Wi-Fi, add the PC LAN frontend origin after a comma.
DATABASE_URL=postgresql://postgres:password@localhost:5432/propertycrest?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false
UPLOAD_DIR=./uploads-private
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Public property listing photos (do not store agent certificates here)
PROPERTY_IMAGE_DIR=./uploads-property
API_PUBLIC_ORIGIN=http://localhost:4000

# Optional hosted agent subscription checkout (Paystack test/live secret)
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5173/?billing=return
